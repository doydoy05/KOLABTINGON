# Local open-source AI chat backend settings
LOCAL_LLAMA_MODEL_PATH=models/Llama-2-7b-chat.gguf
HF_MODEL=meta-llama/Llama-2-7b-chat-hf
HF_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
PORT=8000

# Path to the SQLite file. A relative path resolves against the backend file's
# folder (never the launch folder), so `storage.db` always means the same file
# no matter where you start the server from. All accounts live in this file —
# code edits, restarts, and redeploys never touch existing rows.
# On hosts WITHOUT a persistent disk, redeploys wipe this file: either mount
# one and point STORAGE_DB_PATH at it, or keep the auto snapshots in backups/
# (written on every boot) and restore with scripts/restore_data.py.
STORAGE_DB_PATH=storage.db

# Production hardening (see README "Going live").
FRONTEND_ORIGIN=*
# Proxy headers (X-Forwarded-For) are trusted by default so rate limiting sees
# real client IPs behind Render/Netlify/load balancers. Set TRUST_PROXY=0 only
# when the backend is directly exposed to the internet without a proxy.
TRUST_PROXY=
REQUIRE_CHAT_AUTH=
# Throttle tuning — every scope is env-overridable (defaults are generous so
# legit visitors sharing one egress IP never see a 429; only bots do).
# Per-scope: RATE_LIMIT_<SET|CHAT|LOGIN|RESET|TRACK|RATING> and
# RATE_LIMIT_<SCOPE>_WINDOW (seconds).
LOGIN_IP_LIMIT=120
LOGIN_IP_WINDOW=300
LOGIN_FAIL_LIMIT=20
LOGIN_FAIL_WINDOW=900

# First-admin bootstrap: seeds the admin account ONLY when it is missing.
# Restarts never overwrite an existing account (renames and password changes
# made in the dashboard survive). Recovery: restart once with ADMIN_REPAIR=1
# to force these env values back onto the admin account, then unset it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_REPAIR=
ADMIN_EMAIL=
# Display name for the admin (e.g. the sitting Punong Barangay). When a new
# Punong Barangay is elected, either rename via Dashboard > Settings > Profile
# (survives restarts) or set ADMIN_FULLNAME here and restart to apply it.
ADMIN_FULLNAME=
# Set DISABLE_DEMO_ADMIN=1 after deleting the demo account so restarts never
# recreate it. (To recover it later, unset this and restart.)
DISABLE_DEMO_ADMIN=
# Set ADMIN_HIDDEN=1 to keep the bootstrap admin out of every officials list
# (it can still log in and manage everything).
ADMIN_HIDDEN=

# SMTP for password-reset emails (required: reset codes are emailed to the
# account's Gmail, never returned in the API response)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
